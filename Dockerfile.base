# syntax=docker/dockerfile:1
# PHP base with only the extensions the app uses. Debian (not Alpine) so
# install-php-extensions downloads prebuilt binaries instead of installing gcc
# and compiling.
#   pdo_mysql  database          gd      media-library image driver
#   exif       spatie/image      pcntl   queue worker signals
#   opcache    performance       redis   phpredis (REDIS_CLIENT=phpredis)
# Not installed: mbstring (already built into php:8.3-fpm), intl, zip, bcmath
# (nothing requires them; composer extracts archives with unzip).
# www-data is uid/gid 82 (as on Alpine) so bind-mounted storage/ keeps its host ownership.
# Rebuild only when extensions change:
#   docker build -f Dockerfile.base -t avarewase-auth-base:8.3 .
FROM php:8.3-fpm

COPY --from=ghcr.io/mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends supervisor unzip \
    && rm -rf /var/lib/apt/lists/* \
    && install-php-extensions pdo_mysql gd exif pcntl opcache redis \
    && groupmod -g 82 www-data && usermod -u 82 www-data
