# syntax=docker/dockerfile:1
# PHP base with all extensions compiled. Rebuild only when extensions change:
#   docker build -f Dockerfile.base -t avarewase-auth-base:8.3 .
FROM php:8.3-fpm-alpine

COPY --from=ghcr.io/mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/
RUN apk add --no-cache supervisor unzip \
    && install-php-extensions pdo_mysql mbstring bcmath zip intl gd exif pcntl opcache redis
