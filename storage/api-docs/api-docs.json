                ],
                "summary": "Get the authenticated user's profile",
                "operationId": "f7776a9dbf516cf5166949db0bc230c8",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/security": {
            "get": {
                "tags": [
                    "Security"
                ],
                "summary": "Current MFA status",
                "description": "Current MFA status. Recovery codes are only ever returned at the moment\nthey're (re)generated (enable/confirm), never re-fetchable here.",
                "operationId": "652dd86f2b6f270d8f33adaa40ac4bc3",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "mfa_enabled": {
                                            "type": "boolean"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/security/mfa/enable": {
            "post": {
                "tags": [
                    "Security"
                ],
                "summary": "Start MFA setup (generate secret + QR code)",
                "description": "Start MFA setup: generate a secret + QR code. Unlike the web flow\n(which stashes the pending secret in the session), a stateless caller\ngets it back as an encrypted `setup_token` to round-trip to confirm().",
                "operationId": "3be6ef4280b2614ed18e357468f03d92",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "setup_token": {
                                            "description": "Encrypted secret; round-trip this to /api/security/mfa/confirm",
                                            "type": "string"
                                        },
                                        "secret": {
                                            "type": "string"
                                        },
                                        "qr_code_svg": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/security/mfa/confirm": {
            "post": {
                "tags": [
                    "Security"
                ],
                "summary": "Confirm MFA setup with a TOTP code",
                "operationId": "6bacd9316b3a98dbde1506b81b641949",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "setup_token",
                                    "code"
                                ],
                                "properties": {
                                    "setup_token": {
                                        "type": "string"
                                    },
                                    "code": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "MFA enabled.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "recovery_codes": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid code or expired setup session",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/security/mfa/disable": {
            "post": {
                "tags": [
                    "Security"
                ],
                "summary": "Disable MFA",
                "operationId": "ad94fa26751f4072eae68d1b17415cca",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code"
                                ],
                                "properties": {
                                    "code": {
                                        "description": "TOTP code or a recovery code",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "MFA disabled.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid code",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/security/password": {
            "post": {
                "tags": [
                    "Security"
                ],
                "summary": "Change password (requires MFA code)",
                "operationId": "2ef7e3c2afd2a97d0123b1caefa8884d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password",
                                    "password_confirmation",
                                    "code"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "code": {
                                        "description": "TOTP code or a recovery code",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password updated.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error or invalid MFA code",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "description": "Pure attribute holders for reusable OpenAPI component schemas.\nReferenced from controllers as `#[OA\\JsonContent(ref: '#/components/schemas/User')]`.",
                        "type": "integer",
                        "example": 1
                    },
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "membership_code": {
                        "type": "string",
                        "example": "AV-00123"
                    },
                    "name": {
                        "type": "string",
                        "example": "Micheal Samir"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "phone": {
                        "type": "string",
                        "nullable": true
                    },
                    "date_of_birth": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "avatar": {
                        "type": "string",
                        "nullable": true
                    },
                    "role": {
                        "type": "string"
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "requires_data_update": {
                        "type": "boolean"
                    },
                    "is_admin": {
                        "type": "boolean"
                    },
                    "mfa_enabled": {
                        "type": "boolean"
                    },
                    "mfa_enabled_at": {
                        "type": "string",
                        "nullable": true
                    },
                    "mfa_recovery_codes_remaining": {
                        "type": "integer",
                        "nullable": true
                    },
                    "mfa_recovery_codes_total": {
                        "type": "integer"
                    },
                    "can_manage_admin_access": {
                        "type": "boolean"
                    },
                    "can_manage_cmc_posts": {
                        "type": "boolean"
                    },
                    "stage": {
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string"
                            },
                            "code": {
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    "email_verified_at": {
                        "type": "string",
                        "nullable": true
                    },
