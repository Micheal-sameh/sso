        "/api/notifications/read-many": {
            "post": {
                "tags": [
                    "Notifications"
                ],
                "summary": "Mark specific notifications as read",
                "operationId": "8795cd0b503a0d33c5dc352f12bcf5e7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "ids"
                                ],
                                "properties": {
                                    "ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Marked as read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/password/forgot": {
            "post": {
                "tags": [
                    "Password Reset"
                ],
                "summary": "Request a password reset email (client-authenticated, no user token)",
                "description": "Allow a registered OAuth client to request a password reset email be\nsent to one of its users, authenticating via client_id/client_secret.",
                "operationId": "899384033a2ba88ca7180330148da409",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "client_id",
                                    "client_secret"
                                ],
                                "properties": {
                                    "client_id": {
                                        "type": "string"
                                    },
                                    "client_secret": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "description": "Required if membership_code is omitted",
                                        "type": "string",
                                        "format": "email",
                                        "nullable": true
                                    },
                                    "membership_code": {
                                        "description": "Required if email is omitted",
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Email sent (if the account exists).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid client credentials"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/me": {
            "get": {
