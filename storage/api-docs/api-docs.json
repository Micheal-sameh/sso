{
    "openapi": "3.0.0",
    "info": {
        "title": "Avarewase SSO API",
        "description": "Member-facing API consumed by the first-party \"Avarewase Passport\" mobile app: authentication, profile, security (MFA), connected apps, the home dashboard, CMC posts, and notifications.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current host"
        }
    ],
    "paths": {
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log in with membership code + password",
                "description": "First-party mobile login: verify membership code + password directly\nagainst this SSO (no OAuth consent screen, since this isn't a\nthird-party client). Issues a token immediately, or an MFA challenge\nif the account has two-factor enabled.",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "membership_code",
                                    "password"
                                ],
                                "properties": {
                                    "membership_code": {
                                        "type": "string",
                                        "example": "AV-00123"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "minLength": 8
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Either an access token, or an MFA challenge if the account has 2FA enabled.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "properties": {
                                                "token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "Bearer"
                                                },
                                                "user": {
                                                    "$ref": "#/components/schemas/User"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        {
                                            "properties": {
                                                "mfa_required": {
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "mfa_token": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/auth/mfa/verify": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Complete a login that required MFA",
                "description": "Complete a login that required MFA, exchanging the challenge token\nfrom login() plus a TOTP/recovery code for an access token.",
                "operationId": "95575bcc3f936a950aa075c0dafc262f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mfa_token",
                                    "code"
                                ],
                                "properties": {
                                    "mfa_token": {
                                        "description": "Returned by /api/auth/login when mfa_required is true",
                                        "type": "string"
                                    },
                                    "code": {
                                        "description": "TOTP code or a recovery code",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Access token issued.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid or expired MFA code/token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke the current access token",
                "description": "Revoke the access token used to authenticate this request.",
                "operationId": "df9bdc6c7a6d9f20b983526b2ec0f698",
                "responses": {
                    "200": {
                        "description": "Logged out.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/cmc-posts": {
            "get": {
                "tags": [
                    "CMC Posts"
                ],
                "summary": "List CMC posts (paginated, newest first)",
                "operationId": "ffe1e641d17204e4769ad878bc984161",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/PaginatedResponse"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/CmcPost"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/cmc-posts/{cmcPost}": {
            "get": {
                "tags": [
                    "CMC Posts"
                ],
                "summary": "Get a single CMC post",
                "operationId": "bfa63206fac33cdbe3ac912676104e0e",
                "parameters": [
                    {
                        "name": "cmcPost",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CmcPost"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/connected-apps": {
            "get": {
                "tags": [
                    "Connected Apps"
                ],
                "summary": "List authorized OAuth clients (active tokens)",
                "operationId": "dd769f33107caf339b5dbc22f7390a1e",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/connected-apps/{tokenId}": {
            "delete": {
                "tags": [
                    "Connected Apps"
                ],
                "summary": "Revoke an authorized app's access",
                "operationId": "51ef01a439a43b470eac24d321694c28",
                "parameters": [
                    {
                        "name": "tokenId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Revoked.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Token not found or not owned by this user"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/home": {
            "get": {
                "tags": [
                    "Home"
                ],
                "summary": "Dashboard data (Coptic date + recent CMC posts)",
                "operationId": "d65ef76cbb32ae304c5a24c525b95adb",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "coptic": {
                                            "$ref": "#/components/schemas/CopticDate"
                                        },
                                        "recent_posts": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CmcPost"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/notifications": {
            "get": {
                "tags": [
                    "Notifications"
